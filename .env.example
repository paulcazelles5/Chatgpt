# Fill these values in Railway Variables; never commit a real .env file.
DISCORD_TOKEN=replace_with_new_bot_token
DISCORD_CLIENT_ID=replace_with_application_id
DISCORD_CLIENT_SECRET=replace_with_oauth_client_secret
OWNER_ID=replace_with_owner_discord_id
PAYOUT_CENTRAL_SERVER_ID=
VERIFIED_ROLE_ID=
PORT=3000
PUBLIC_BASE_URL=https://your-service.up.railway.app
OAUTH_REDIRECT_PATH=/oauth/callback
SESSION_SECRET=replace_with_a_long_random_secret
DB_PATH=/app/data/payout-central.sqlite
BASE_REWARD=2
MAX_QUEUE=10
